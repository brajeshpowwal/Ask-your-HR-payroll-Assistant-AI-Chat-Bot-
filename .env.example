# Copy this file to .env and fill it in.  NEVER commit .env to GitHub.

# Which model provider to use: groq | gemini | ollama | anthropic | nvidia
LLM_PROVIDER=groq

# Optional: override the default model name for the provider.
# Providers retire models often; check their model list if a default stops working.
# LLM_MODEL=openai/gpt-oss-120b

# Reasoning models can think before replying: much slower, not more accurate in our
# NVIDIA benchmark. Default off. on = allow thinking (currently honoured for NVIDIA).
# LLM_THINKING=off

# API keys (only the one for your provider is needed)
GROQ_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Safety and demo limits
MAX_ROWS=500
QUERY_TIMEOUT_SECONDS=10
MAX_SQL_RETRIES=3
NUM_EXAMPLES=4
MAX_QUESTIONS_PER_SESSION=25
